# Copy to .env (gitignored) and fill in your own key.
# Used only by `npm run fetch:ev` (src/fetch-ev-chargers.js) — everything
# else in this repo runs with no .env file at all.

# Free key from https://openchargemap.org/site/developerinfo. Optional: if
# this is unset, the EV-charger fetch just uses OpenStreetMap alone, same as
# before Open Charge Map support existed.
OCM_API_KEY=
